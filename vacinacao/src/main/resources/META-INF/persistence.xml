<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="vacinacaoPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- As entidades em br.ufg.vacinacao.model são descobertas por varredura -->
        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>
            <!-- Conexão. Usuário/senha/URL podem ser sobrescritos por variáveis de
                 ambiente (VACINACAO_DB_URL, VACINACAO_DB_USER, VACINACAO_DB_PASSWORD) - ver JPAUtil -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/vacinacao?useUnicode=true&amp;characterEncoding=UTF-8&amp;serverTimezone=America/Sao_Paulo"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!-- Dialeto detectado automaticamente pelo Hibernate -->

            <!-- O esquema é criado por sql/schema.sql; o Hibernate apenas confere o mapeamento -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>

            <!-- Desenvolvimento -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

            <property name="hibernate.connection.pool_size" value="10"/>
        </properties>
    </persistence-unit>
</persistence>
