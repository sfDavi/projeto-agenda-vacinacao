<%-- Modal de confirmação da baixa (Item 5). Preenchido por assets/app.js a partir do botão clicado.
     Requer a variável "urlAtual" (destino após a baixa). --%>
<div class="modal fade" id="modalBaixa" tabindex="-1" aria-labelledby="modalBaixaTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" action="${ctx}/agendas/baixa" class="modal-content">
            <input type="hidden" name="id" value="">
            <input type="hidden" name="acao" value="">
            <input type="hidden" name="voltar" value="${fn:escapeXml(urlAtual)}">
            <div class="modal-header">
                <h2 class="modal-title h5" id="modalBaixaTitulo">Dar baixa</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2" data-baixa-pergunta></p>
                <p class="fw-semibold mb-3" data-baixa-descricao></p>
                <p class="small text-body-secondary mb-3">A data da situação será registrada como a data de hoje.</p>
                <div data-baixa-motivo>
                    <label for="motivoBaixa" class="form-label">Motivo do cancelamento <span class="text-body-secondary">(opcional)</span></label>
                    <textarea class="form-control" id="motivoBaixa" name="motivo" rows="2" maxlength="150"
                              placeholder="Ex.: paciente com febre, faltou, reagendar"></textarea>
                    <div class="form-text">Será registrado nas observações da agenda.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Voltar</button>
                <button type="submit" class="btn" data-baixa-confirmar>Confirmar</button>
            </div>
        </form>
    </div>
</div>
